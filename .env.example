# Downloadarr Media Stack Environment Configuration
# Copy this file to .env and customize the values for your system

# ===================================================================
# USER & GROUP CONFIGURATION
# ===================================================================
# Find your user/group IDs with: id $(whoami)
PUID=1000
PGID=1000
TZ=America/New_York
UMASK=022

# ===================================================================
# PATH CONFIGURATION
# ===================================================================
# Adjust these paths to match your system structure
BASE_PATH=/volume1/docker
MEDIA_PATH=/volume1
DOWNLOADS_PATH=/volume1/docker/qbittorrent/downloads

# ===================================================================
# SERVICE PORTS
# ===================================================================
# Change these if you have port conflicts
FLARESOLVERR_PORT=8191
HUNTARR_PORT=9705
LIDARR_PORT=8686
PROWLARR_PORT=9696
RADARR_PORT=7878
QBITTORRENT_PORT=9865
QBITTORRENT_PEER_PORT=6881

# ===================================================================
# FLARESOLVERR CONFIGURATION
# ===================================================================
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none

# ===================================================================
# QBITTORRENT CONFIGURATION
# ===================================================================
QBITTORRENT_MEMORY_LIMIT=2g
FILESYSTEM_CACHE=1G
# Adjust subnet whitelist to match your network (find with: ip route | grep default)
WEBUI_AUTH_SUBNETWHITELIST=192.168.1.0/24,172.17.0.0/16
WEBUI_AUTH_LOCAL_AUTH_BYPASS=true

# ===================================================================
# CONTAINER MANAGEMENT
# ===================================================================
RESTART_POLICY=unless-stopped